# ============================================================
# HBD — HOME BOARD DESIGNER
# CONFIGURACIÓN DE ENTORNO (.env.example)
# ============================================================

# Entorno de ejecución
NODE_ENV=development
PORT=4000
CLIENT_PORT=3003
VITE_API_URL=http://localhost:4000/api

# Identidad y Marca del Proyecto (Punto único de configuración)
APP_NAME=HBD — Home Board Designer
APP_TAGLINE=Diseña, mide y visualiza tu vivienda.
APP_AUTHOR=apalma
APP_VERSION=1.0.0
APP_COPYRIGHT=© 2026 HBD — Home Board Designer

# Base de Datos PostgreSQL
POSTGRES_USER=hbd_user
POSTGRES_PASSWORD=hbd_secure_password
POSTGRES_DB=hbd_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hbd_user:hbd_secure_password@localhost:5432/hbd_db?schema=public

# Seguridad y Autenticación JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Almacenamiento de archivos y uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# CORS
CORS_ORIGIN=http://localhost:3003

# Administrador Inicial (Semilla segura)
ADMIN_EMAIL=admin@hbd.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin1234!
ADMIN_NAME=Administrador del Sistema
