# ============================================================
# HBD — HOME BOARD DESIGNER
# CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env.example)
# ============================================================
#
# Autor: Adrián Palma
# Copyright: © 2026 Adrián Palma — HBD (Home Board Designer)
#
# Copia este archivo como .env para desarrollo local:
#   cp .env.example .env
#
# NUNCA introduzcas credenciales ni secretos reales en este archivo
# ni en el repositorio de código.
# ============================================================

# ------------------------------------------------------------
# 1. ENTORNO GENERAL & PUERTOS
# ------------------------------------------------------------
# Entorno: development | production | test
NODE_ENV=development

# Puerto del Servidor Backend API (Interno / Local)
PORT=4000

# Puerto del Frontend Web Client (Acceso en navegador: http://localhost:3003)
CLIENT_PORT=3003

# URL base del API consumida por el cliente frontend
# Local: http://localhost:4000/api
# Producción/Docker detrás de reverse proxy: /api
VITE_API_URL=/api

# ------------------------------------------------------------
# 2. IDENTIDAD Y MARCA CENTRALIZADA (Única Fuente de Verdad)
# ------------------------------------------------------------
APP_NAME=HBD — Home Board Designer
APP_TAGLINE=Diseña, mide y visualiza tu vivienda.
APP_AUTHOR=Adrián Palma
APP_VERSION=1.24.5
APP_PHASE=V24
APP_COPYRIGHT=© 2026 Adrián Palma — HBD (Home Board Designer)

# ------------------------------------------------------------
# 3. BASE DE DATOS POSTGRESQL & PERSISTENCIA
# ------------------------------------------------------------
# Credenciales para el contenedor PostgreSQL
POSTGRES_USER=hbd_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=hbd_db
POSTGRES_PORT=5432

# Cadena de conexión para Prisma ORM
# Local: postgresql://hbd_user:password@localhost:5432/hbd_db?schema=public
# Docker Compose Local: postgresql://hbd_user:password@postgres:5432/hbd_db?schema=public
# Portainer Stack: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@hbd-db:5432/${POSTGRES_DB}?schema=public
DATABASE_URL=postgresql://hbd_user:your_secure_postgres_password_here@localhost:5432/hbd_db?schema=public

# ------------------------------------------------------------
# 4. SEGURIDAD Y AUTENTICACIÓN JWT
# ------------------------------------------------------------
# Clave secreta robusta para firmar tokens JWT (Generar cadena aleatoria de 64+ caracteres en producción)
JWT_SECRET=generate_a_secure_random_64_character_secret_for_production
JWT_EXPIRES_IN=7d

# Orígenes permitidos para CORS (separados por coma si son varios)
CORS_ORIGIN=http://localhost:3003

# ------------------------------------------------------------
# 5. ALMACENAMIENTO DE ARCHIVOS & UPLOADS
# ------------------------------------------------------------
# Directorio para almacenar planos, renders y modelos persistentes
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# ------------------------------------------------------------
# 6. MOTORES DE IA (OPCIONALES — MOCK POR DEFECTO)
# ------------------------------------------------------------
# IA de Diseño e Interiorismo
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o

# IA de Visión Artificial
AI_VISION_PROVIDER=mock
AI_VISION_API_KEY=
AI_VISION_MODEL=gpt-4o

# ------------------------------------------------------------
# 7. ADMINISTRADOR INICIAL (SEMILLA DE BASE DE DATOS)
# ------------------------------------------------------------
ADMIN_EMAIL=admin@hbd.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_initial_admin_password_change_after_first_login
ADMIN_NAME=Administrador del Sistema

# ------------------------------------------------------------
# 8. VARIABLES ESPECÍFICAS PARA PORTAINER STACK
# ------------------------------------------------------------
# Etiqueta de la imagen Docker publicada en GHCR (latest, 9.0.0, etc.)
HBD_VERSION=latest

# Puerto externo publicado en el host de producción
HBD_EXTERNAL_PORT=3003
