  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@map("ar_measurements")
}

model ARCapture {
  id              String    @id @default(uuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneId         String?
  scene           ARScene?  @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  imageUrl        String
  title           String?
  caption         String?
  cameraPose      Json?     @default("{}")
  metadata        Json?     @default("{}")
  createdAt       DateTime  @default(now())

  @@map("ar_captures")
}

// ==========================================
// V23: PROPERTY INTELLIGENCE MODELS
// ==========================================

enum PropertyType {
  APARTMENT
  HOUSE
  DUPLEX
  PENTHOUSE
  STUDIO
  TOWNHOUSE
  VILLA
  OFFICE
  COMMERCIAL
  OTHER
}

enum PropertyCondition {
  NEW
  GOOD
  NEEDS_UPDATE
  RENOVATION_REQUIRED
  PARTIAL_RENOVATION
  FULL_RENOVATION
  UNKNOWN
}

enum PropertyStatus {
  ACTIVE
  IN_PLANNING
  UNDER_RENOVATION
  COMPLETED
  ARCHIVED
  DRAFT
}

enum OccupancyStatus {
  VACANT
  OCCUPIED_OWNER
  OCCUPIED_TENANT
  UNDER_CONSTRUCTION
  UNKNOWN
}

enum DataSourceType {
  OFFICIAL
  USER_PROVIDED
  DOCUMENT
  PLAN
  IMAGE
  VISION
  CATALOG
  MEASURED
  CALCULATED
  IMPORTED
  AI_ESTIMATED
  MANUAL
  UNKNOWN
}

enum ConfidenceLevel {
  CONFIRMED
  ESTIMATED
  CALCULATED
  UNKNOWN
}

enum ImprovementPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ImprovementCategory {
  REDISTRIBUTION
  OPEN_CONCEPT
  STORAGE
  LIGHTING
  HVAC
  NETWORK_WIFI
  SMART_HOME
  SECURITY
  KITCHEN_RENOVATION
  BATHROOM_RENOVATION
  INSULATION
  ENERGY_EFFICIENCY
  ACCESSIBILITY
  FINISHES
}

enum RiskCategory {
  STRUCTURAL
  ELECTRICAL
  PLUMBING
  HVAC
  NETWORK
  SECURITY
  MOISTURE
  SPACE
  COST
  SCHEDULE
  SUPPLY
  UNKNOWN
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  UNKNOWN
}

enum PropertySnapshotStateType {
  INITIAL_EXISTING
  PROPOSED_DESIGN
  DURING_RENOVATION
  EXECUTED_FINAL
  CUSTOM
}

model Property {
  id                 String             @id @default(uuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  propertyType       PropertyType       @default(APARTMENT)
  status             PropertyStatus     @default(ACTIVE)
  condition          PropertyCondition  @default(UNKNOWN)
  occupancyStatus    OccupancyStatus    @default(UNKNOWN)
  address            Json?              @default("{}")
  builtSurfaceM2     Float?
  usableSurfaceM2    Float?
  plotSurfaceM2      Float?
  roomsCount         Int?
  bathroomsCount     Int?
  bedroomsCount      Int?
  floorNumber        Int?
  totalFloors        Int?               @default(1)
  constructionYear   Int?
  renovationYear     Int?
  orientation        String?
  energyRating       String?
  source             DataSourceType     @default(USER_PROVIDED)
  confidence         ConfidenceLevel    @default(CONFIRMED)
  metadata           Json?              @default("{}")
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  projects           Project[]
  snapshots          PropertySnapshot[]
  opportunities      PropertyOpportunity[]
  risks              PropertyRisk[]
  aiConversations    AIConversation[]
  aiInteractions     AIInteraction[]

  @@map("properties")
}

model PropertySnapshot {
  id             String                    @id @default(uuid())
  propertyId     String
  property       Property                  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  name           String
  stateType      PropertySnapshotStateType @default(INITIAL_EXISTING)
  description    String?
  snapshotData   Json                      @default("{}")
  metricsSummary Json?                     @default("{}")
  createdAt      DateTime                  @default(now())

  @@map("property_snapshots")
}

model PropertyOpportunity {
  id                  String              @id @default(uuid())
  propertyId          String
  property            Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  projectId           String?
  title               String
  description         String
  category            ImprovementCategory @default(REDISTRIBUTION)
  priority            ImprovementPriority @default(MEDIUM)
  estimatedCostEur    Float?
  impactScore         Float               @default(50)
  potentialSavingsEur Float?
  dependencies        Json?               @default("[]")
  source              DataSourceType      @default(AI_ESTIMATED)
  confidence          ConfidenceLevel     @default(ESTIMATED)
  status              String              @default("IDENTIFIED")
  metadata            Json?               @default("{}")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@map("property_opportunities")
}

model PropertyRisk {
  id                          String          @id @default(uuid())
  propertyId                  String
  property                    Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  projectId                   String?
  title                       String
  description                 String
  category                    RiskCategory    @default(UNKNOWN)
  severity                    RiskSeverity    @default(MEDIUM)
  isPotential                 Boolean         @default(true)
  requiresProfessionalReview Boolean         @default(true)
  mitigationSuggestion        String?
  source                      DataSourceType  @default(AI_ESTIMATED)
  confidence                  ConfidenceLevel @default(ESTIMATED)
  status                      String          @default("OPEN")
  metadata                    Json?           @default("{}")
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt

  @@map("property_risks")
}

// ============================================================
// V24.0.0 / 1.24.0 — HBD AI COPILOT & ORCHESTRATION
// ============================================================

model AIConversation {
  id           String          @id @default(uuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  propertyId   String?
  property     Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  title        String
  context      Json?           @default("{}")
  isPinned     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  messages     AIMessage[]
  interactions AIInteraction[]
  actions      AIAction[]

  @@map("ai_conversations")
}

model AIMessage {
  id                String         @id @default(uuid())
  conversationId    String
  conversation      AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender            String         // USER, COPILOT, SYSTEM
  content           String
  intent            String?
  structuredPayload Json?          @default("{}")
  toolCalls         Json?          @default("[]")
  confidence        String?        @default("HIGH")
  tokens            Int?
  latencyMs         Int?
  createdAt         DateTime       @default(now())

  @@map("ai_messages")
}

model AIInteraction {
  id                   String            @id @default(uuid())
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId            String?
  project              Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  propertyId           String?
  property             Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  conversationId       String?
  conversation         AIConversation?   @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  intent               String
  toolName             String?
  inputSummary         Json?             @default("{}")
  outputSummary        Json?             @default("{}")
  status               String            @default("SUCCESS") // SUCCESS, FAILED, REJECTED, CANCELLED
  latencyMs            Int?
  requiresConfirmation Boolean           @default(false)
  createdAt            DateTime          @default(now())

  toolExecutions       AIToolExecution[]

  @@map("ai_interactions")
}

model AIAction {
  id                   String          @id @default(uuid())
  userId               String
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId            String?
  project              Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  conversationId       String?
  conversation         AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  type                 String          // ADD_FURNITURE, MOVE_FURNITURE, CREATE_SCENARIO, etc.
  entityType           String?
  entityId             String?
  parameters           Json            @default("{}")
  reason               String?
  confidence           String          @default("HIGH")
  riskLevel            String          @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  requiresConfirmation Boolean         @default(false)
  status               String          @default("PENDING") // PENDING, CONFIRMED, EXECUTED, REJECTED, CANCELLED, FAILED
  result               Json?           @default("{}")
  executedAt           DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@map("ai_actions")
}

model AIToolExecution {
  id            String        @id @default(uuid())
  interactionId String
  interaction   AIInteraction @relation(fields: [interactionId], references: [id], onDelete: Cascade)
  toolName      String
  inputParams   Json          @default("{}")
  outputData    Json?         @default("{}")
  status        String        @default("SUCCESS")
  errorMessage  String?
  durationMs    Int?
  createdAt     DateTime      @default(now())

  @@map("ai_tool_executions")
}

model AIUsage {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider         String   @default("mock")
  model            String   @default("hbd-copilot-default")
  tokensPrompt     Int      @default(0)
  tokensCompletion Int      @default(0)
  totalTokens      Int      @default(0)
  estimatedCostEur Float    @default(0)
  latencyMs        Int      @default(0)
  operation        String   @default("copilot_chat")
  createdAt        DateTime @default(now())

  @@map("ai_usages")
}




