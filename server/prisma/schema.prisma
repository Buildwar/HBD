datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleName {
  ADMIN
  DESIGNER
  USER
  VIEWER
}

enum WallType {
  EXTERIOR
  INTERIOR
  PARTITION
  LOAD_BEARING
}

enum FloorPlanStatus {
  UPLOADED
  PROCESSING
  ANALYZED
  VALIDATED
  FAILED
}

enum LogLevel {
  INFO
  WARN
  ERROR
  DEBUG
}

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  username         String       @unique
  name             String
  passwordHash     String
  avatar           String?
  language         String       @default("es")
  themePreferences Json         @default("{\"themeMode\":\"dark\",\"accentColor\":\"#10b981\",\"borderRadius\":\"0.75rem\",\"density\":\"normal\"}")
  isActive         Boolean      @default(true)
  roleId           String
  role             Role         @relation(fields: [roleId], references: [id])
  projects         Project[]
  images           ProjectImage[]
  customFurniture  Furniture[]
  systemLogs       SystemLog[]
  aiDesignHistories AIDesignHistory[]
  assignedTasks    ConstructionTask[]
  favorites        ProductFavorite[]
  properties       Property[]
  aiConversations  AIConversation[]
  aiInteractions   AIInteraction[]
  aiActions        AIAction[]
  aiUsages         AIUsage[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  name        String
  description String
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Project {
  id             String                @id @default(uuid())
  name           String
  description    String?
  address        String?
  propertyType   String?               @default("residential")
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId     String?
  property       Property?             @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  isArchived     Boolean               @default(false)
  thumbnail      String?
  floors         Floor[]
  renders        Render[]
  images         ProjectImage[]
  aiDesignHistories AIDesignHistory[]
  designVariants DesignVariantRecord[]
  constructionProject ConstructionProject?
  scenarios      ProjectScenario[]
  optimizationRequests OptimizationRequest[]
  documents      ProjectDocument[]
  executionProjects ExecutionProject[]
  products       Product[]
  projectProducts ProjectProduct[]
  shoppingListItems ShoppingListItem[]
  propertyAcquisition PropertyAcquisition?
  costItems      CostItem[]
  projectPayments ProjectPayment[]
  budgetRevisions BudgetRevision[]
  financialSnapshots FinancialSnapshot[]
  procurementItems ProcurementItem[]
  procurementOrders ProcurementOrder[]
  supplierQuotes SupplierQuote[]
  procurementIncidents ProcurementIncident[]
  procurementReturns ProcurementReturn[]
  materialRequirements MaterialRequirement[]
  technicalElements    TechnicalElement[]
  technicalConnections TechnicalConnection[]
  technicalZones       TechnicalZone[]
  technicalDependencies TechnicalDependency[]
  arScenes             ARScene[]
  arCaptures           ARCapture[]
  aiConversations      AIConversation[]
  aiInteractions       AIInteraction[]
  aiActions            AIAction[]
  aiUsages             AIUsage[]
  createdAt            DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@map("projects")
}

model Floor {
  id                  String               @id @default(uuid())
  projectId           String
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                String
  level               Int                  @default(0)
  order               Int                  @default(0)
  heightM             Float                @default(2.50)
  floorPlans          FloorPlan[]
  walls               Wall[]
  rooms               Room[]
  spaces              Space[]
  doors               Door[]
  windows             Window[]
  measurements        Measurement[]
  furniturePlacements FurniturePlacement[]
  technicalElements    TechnicalElement[]
  technicalConnections TechnicalConnection[]
  technicalZones       TechnicalZone[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("floors")
}

model FloorPlan {
  id                      String          @id @default(uuid())
  floorId                 String
  floor                   Floor           @relation(fields: [floorId], references: [id], onDelete: Cascade)
  originalFileName        String
  fileUrl                 String
  mimeType                String
  fileSize                Int
  widthPx                 Int?
  heightPx                Int?
  scaleFactor             Float? // Pixels per meter
  status                  FloorPlanStatus @default(UPLOADED)
  detectedElementsSummary Json?
  analysisData            Json?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@map("floor_plans")
}

model Wall {
  id         String   @id @default(uuid())
  floorId    String
  floor      Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  startX     Float
  startY     Float
  endX       Float
  endY       Float
  thicknessM Float    @default(0.15)
  heightM    Float    @default(2.50)
  wallType   WallType @default(INTERIOR)
  doors      Door[]
  windows    Window[]
  technicalElements TechnicalElement[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("walls")
}

model Room {
  id        String   @id @default(uuid())
  floorId   String
  floor     Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  spaceId   String?
  space     Space?   @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  name      String
  roomType  String?
  polygon   Json // Array of {x, y} coordinates
  areaM2    Float
  widthM    Float?
  lengthM   Float?
  heightM   Float    @default(2.50)
  color     String?  @default("#3b82f6")
  technicalElements TechnicalElement[]
  technicalZones    TechnicalZone[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rooms")
}

model Door {
  id             String   @id @default(uuid())
  wallId         String
  wall           Wall     @relation(fields: [wallId], references: [id], onDelete: Cascade)
  floorId        String
  floor          Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  posX           Float
  posY           Float
  widthM         Float    @default(0.80)
  heightM        Float    @default(2.10)
  rotationDeg    Float    @default(0)
  swingDirection String   @default("INWARD_RIGHT")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("doors")
}

model Window {
  id          String   @id @default(uuid())
  wallId      String
  wall        Wall     @relation(fields: [wallId], references: [id], onDelete: Cascade)
  floorId     String
  floor       Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  posX        Float
  posY        Float
  widthM      Float    @default(1.20)
  heightM     Float    @default(1.20)
  elevationM  Float    @default(0.90)
  rotationDeg Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("windows")
}

model Measurement {
  id        String   @id @default(uuid())
  floorId   String
  floor     Floor    @relation(fields: [floorId], references: [id], onDelete: Cascade)
  startX    Float
  startY    Float
  endX      Float
  endY      Float
  distanceM Float
  label     String?
  createdAt DateTime @default(now())

  @@map("measurements")
}

model FurnitureCategory {
  id          String      @id @default(uuid())
  name        String
  slug        String      @unique
  icon        String?
  description String?
  furniture   Furniture[]

  @@map("furniture_categories")
}

model Furniture {
  id             String               @id @default(uuid())
  name           String
  categoryId     String
  category       FurnitureCategory    @relation(fields: [categoryId], references: [id])
  defaultWidthM  Float
  defaultDepthM  Float
  defaultHeightM Float
  model3dUrl     String?
  imageUrl       String?
  isCustom       Boolean              @default(false)
  userId         String?
  user           User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  placements     FurniturePlacement[]
  products       Product[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@map("furniture")
}

model FurniturePlacement {
  id          String    @id @default(uuid())
  floorId     String
  floor       Floor     @relation(fields: [floorId], references: [id], onDelete: Cascade)
  furnitureId String
  furniture   Furniture @relation(fields: [furnitureId], references: [id], onDelete: Cascade)
  posX        Float
  posY        Float
  posZ        Float     @default(0)
  rotationDeg Float     @default(0)
  widthM      Float
  depthM      Float
  heightM     Float
  technicalElements TechnicalElement[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("furniture_placements")
}

model Render {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  imageUrl  String
  status    String   @default("COMPLETED")
  createdAt DateTime @default(now())

  @@map("renders")
}

model AppSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  isPublic    Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@map("app_settings")
}

model SystemLog {
  id        String   @id @default(uuid())
  level     LogLevel @default(INFO)
  module    String
  message   String
  metadata  Json?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@map("system_logs")
}

model AIDesignHistory {
  id                 String   @id @default(uuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  floorId            String
  roomId             String?
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider           String   @default("mock")
  prompt             String?
  preferences        Json
  proposals          Json
  selectedProposalId String?
  status             String   @default("GENERATED")
  createdAt          DateTime @default(now())

  @@map("ai_design_histories")
}

model DesignVariantRecord {
  id                 String   @id @default(uuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  floorId            String
  name               String
  description        String?
  materialOverrides  Json     @default("{}")
  furnitureOverrides Json     @default("{}")
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("design_variants")
}

model ProjectImage {
  id               String   @id @default(uuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  floorId          String?
  roomId           String?
  sourceType       String   @default("UPLOAD") // PROJECT_PHOTO, ROOM_PHOTO, RENDER, REFERENCE, UPLOAD
  filename         String
  originalFilename String
  url              String
  mimeType         String
  sizeBytes        Int
  width            Int?
  height           Int?
  status           String   @default("UPLOADED") // UPLOADED, ANALYZING, ANALYZED, CONFIRMED, APPLIED, ERROR
  provider         String?  @default("mock")
  analysisData     Json?
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  analyzedAt       DateTime?

  @@map("project_images")
}

// ============================================================
// V11.0.0 — CONSTRUCTION & RENOVATION INTELLIGENCE
// ============================================================

enum ConstructionProjectStatus {
  DRAFT
  PLANNING
  READY_FOR_REVIEW
  IN_PROGRESS
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ConstructionOperationType {
  DEMOLITION
  CONSTRUCTION
  INSTALLATION
  REPLACEMENT
  FINISHING
  FURNISHING
  OTHER
}

enum ConstructionTaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

model ConstructionProject {
  id              String                    @id @default(uuid())
  projectId       String                    @unique
  project         Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status          ConstructionProjectStatus @default(PLANNING)
  notes           String?
  targetStartDate DateTime?
  targetEndDate   DateTime?
  phases          ConstructionPhase[]
  items           ConstructionItem[]
  documents       ConstructionDocument[]
  executionProjects ExecutionProject[]
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@map("construction_projects")
}

model ConstructionPhase {
  id                    String                 @id @default(uuid())
  constructionId        String
  construction          ConstructionProject    @relation(fields: [constructionId], references: [id], onDelete: Cascade)
  name                  String
  description           String?
  order                 Int                    @default(0)
  status                ConstructionTaskStatus @default(TODO)
  estimatedDurationDays Int                    @default(7)
  startDate             DateTime?
  endDate               DateTime?
  dependencies          Json                   @default("[]")
  tasks                 ConstructionTask[]
  checklists            ChecklistItem[]
  workPackages          WorkPackage[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@map("construction_phases")
}

model ConstructionTask {
  id           String                 @id @default(uuid())
  phaseId      String
  phase        ConstructionPhase      @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  status       ConstructionTaskStatus @default(TODO)
  order        Int                    @default(0)
  assigneeId   String?
  assignee     User?                  @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  dependencies Json                   @default("[]")
  executionTasks ExecutionTask[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@map("construction_tasks")
}

model ConstructionItem {
  id                    String                    @id @default(uuid())
  constructionId        String
  construction          ConstructionProject       @relation(fields: [constructionId], references: [id], onDelete: Cascade)
  spaceId               String?
  space                 Space?                    @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  category              String
  operation             ConstructionOperationType @default(CONSTRUCTION)
  name                  String
  description           String?
  quantity              Float                     @default(1)
  unit                  String                    @default("ud")
  wastePercent          Float                     @default(0)
  materialCost          Float                     @default(0)
  laborCost             Float                     @default(0)
  otherCost             Float                     @default(0)
  totalCost             Float                     @default(0)
  confidence            String                    @default("GEOMETRY_CALCULATED")
  supplierId            String?
  supplier              Supplier?                 @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  requiresProValidation Boolean                   @default(false)
  notes                 String?
  materialExecutionItems MaterialExecutionItem[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@map("construction_items")
}

model ChecklistItem {
  id        String            @id @default(uuid())
  phaseId   String
  phase     ConstructionPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  label     String
  isDone    Boolean           @default(false)
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("checklist_items")
}

model Supplier {
  id        String             @id @default(uuid())
  name      String
  contact   String?
  website   String?
  notes     String?
  items     ConstructionItem[]
  materialExecutionItems MaterialExecutionItem[]
  purchaseOrders PurchaseOrder[]
  executionInvoices ExecutionInvoice[]
  materialDeliveries MaterialDelivery[]
  costItems      CostItem[]
  procurementItems ProcurementItem[]
  procurementQuotes SupplierQuote[]
  procurementOrders ProcurementOrder[]
  createdAt DateTime           @default(now())

  @@map("suppliers")
}

model ConstructionDocument {
  id             String              @id @default(uuid())
  constructionId String
  construction   ConstructionProject @relation(fields: [constructionId], references: [id], onDelete: Cascade)
  title          String
  docType        String
  fileUrl        String
  notes          String?
  createdAt      DateTime            @default(now())

  @@map("construction_documents")
}

// ============================================================
// V10.0.0 / V11.0.0 — SPACES & FUNCTIONAL ZONES
// ============================================================

enum FunctionalZoneType {
  LIVING
  DINING
  KITCHEN
  BEDROOM
  BATHROOM
  WORKSPACE
  CIRCULATION
  STORAGE
  TERRACE
  OTHER
}

model Space {
  id                String             @id @default(uuid())
  floorId           String
  floor             Floor              @relation(fields: [floorId], references: [id], onDelete: Cascade)
  name              String
  type              String?            // e.g. OPEN_PLAN, LIVING_AREA, SUITE, CIRCULATION, EXTERIOR
  description       String?
  polygon           Json?              // Array of {x, y} coordinates
  areaM2            Float?             @default(0)
  heightM           Float              @default(2.50)
  color             String?            @default("#10b981")
  rooms             Room[]
  functionalZones   FunctionalZone[]
  constructionItems ConstructionItem[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("spaces")
}

model FunctionalZone {
  id        String             @id @default(uuid())
  spaceId   String
  space     Space              @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name      String
  type      FunctionalZoneType @default(OTHER)
  polygon   Json?              // Array of {x, y} coordinates
  areaM2    Float              @default(0)
  metadata  Json?              @default("{}")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@map("functional_zones")
}

enum ScenarioType {
  CURRENT
  MANUAL
  AI_GENERATED
  DESIGN_VARIANT
  RENOVATION
  CUSTOM
}

enum ScenarioStatus {
  DRAFT
  ANALYZING
  VALID
  WARNING
  INVALID
  ARCHIVED
}

enum ScenarioActionType {
  CREATE_SPACE
  DELETE_SPACE
  MODIFY_SPACE
  CREATE_ZONE
  DELETE_ZONE
  MODIFY_ZONE
  MOVE_WALL
  CREATE_WALL
  DELETE_WALL
  MODIFY_WALL
  MOVE_DOOR
  CREATE_DOOR
  DELETE_DOOR
  MODIFY_DOOR
  MOVE_WINDOW
  CREATE_WINDOW
  DELETE_WINDOW
  MODIFY_WINDOW
  ADD_FURNITURE
  REMOVE_FURNITURE
  MOVE_FURNITURE
  MODIFY_FURNITURE
  CHANGE_MATERIAL
  CHANGE_FINISH
  CHANGE_LIGHTING
  ADD_CONSTRUCTION_ITEM
  REMOVE_CONSTRUCTION_ITEM
  MODIFY_CONSTRUCTION_ITEM
}

model ProjectScenario {
  id               String            @id @default(uuid())
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name             String
  description      String?
  type             ScenarioType      @default(MANUAL)
  status           ScenarioStatus    @default(DRAFT)
  baseScenarioId   String?
  baseScenario     ProjectScenario?  @relation("ScenarioHierarchy", fields: [baseScenarioId], references: [id], onDelete: SetNull)
  derivedScenarios ProjectScenario[] @relation("ScenarioHierarchy")
  snapshotData     Json?             @default("{}")
  metrics          Json?             @default("{}")
  budgetSummary    Json?             @default("{}")
  actions          ScenarioAction[]
  optimizationRequests OptimizationRequest[]
  designAlternatives   DesignAlternative[]
  executionProjects    ExecutionProject[]
  arScenes             ARScene[]
  createdBy        String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("project_scenarios")
}

model ScenarioAction {
  id            String             @id @default(uuid())
  scenarioId    String
  scenario      ProjectScenario    @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  actionType    ScenarioActionType
  payload       Json               @default("{}")
  previousState Json?
  isReverted    Boolean            @default(false)
  sequence      Int                @default(1)
  createdBy     String?
  createdAt     DateTime           @default(now())

  @@map("scenario_actions")
}

// ============================================================
// V13.0.0 — INTELLIGENT DESIGN OPTIMIZATION ENGINE
// ============================================================

enum OptimizationStrategy {
  RULE_BASED
  PARAMETRIC
  HEURISTIC
  AI_ASSISTED
  HYBRID
}

enum OptimizationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AlternativeStatus {
  GENERATED
  ANALYZING
  VALID
  WARNING
  INVALID
  REJECTED
  SELECTED
  ARCHIVED
}

model OptimizationRequest {
  id               String               @id @default(uuid())
  projectId        String
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  baseScenarioId   String?
  baseScenario     ProjectScenario?     @relation(fields: [baseScenarioId], references: [id], onDelete: SetNull)
  name             String               @default("Solicitud de Optimización")
  objectives       Json                 @default("[]")
  constraints      Json                 @default("[]")
  preferences      Json                 @default("{}")
  strategy         OptimizationStrategy @default(PARAMETRIC)
  status           OptimizationStatus   @default(PENDING)
  maxCandidates    Int                  @default(4)
  timeoutMs        Int                  @default(15000)
  executionTimeMs  Int                  @default(0)
  alternatives     DesignAlternative[]
  createdBy        String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@map("optimization_requests")
}

model DesignAlternative {
  id                  String              @id @default(uuid())
  requestId           String
  request             OptimizationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  scenarioId          String?
  scenario            ProjectScenario?    @relation(fields: [scenarioId], references: [id], onDelete: SetNull)
  name                String
  description         String?
  status              AlternativeStatus   @default(GENERATED)
  snapshotData        Json                @default("{}")
  metrics             Json                @default("{}")
  impacts             Json                @default("{}")
  validation          Json                @default("{}")
  explanations        Json                @default("[]")
  selectedBy          String?
  selectedAt          DateTime?
  convertedScenarioId String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@map("design_alternatives")
}

// ============================================================
// V14 — PROFESSIONAL PROJECT DOCUMENTATION & PRESENTATION
// ============================================================

enum DocumentType {
  PROJECT_DOSSIER
  DESIGN_PRESENTATION
  TECHNICAL_REPORT
  RENOVATION_REPORT
  BUDGET_REPORT
  FURNITURE_SCHEDULE
  MATERIAL_SCHEDULE
  SCENARIO_COMPARISON
  CLIENT_PRESENTATION
  CUSTOM
}

enum DocumentStatus {
  DRAFT
  GENERATING
  READY
  WARNING
  FAILED
  ARCHIVED
}

enum DocumentOrientation {
  PORTRAIT
  LANDSCAPE
}

enum DocumentPageSize {
  A4
  A3
}

enum DocumentSectionType {
  COVER
  PROJECT_SUMMARY
  PROJECT_DATA
  EXISTING_PLAN
  PROPOSED_PLAN
  SPACE_ANALYSIS
  FUNCTIONAL_ZONES
  MEASUREMENTS
  FURNITURE
  MATERIALS
  LIGHTING
  CONSTRUCTION
  BUDGET
  SCENARIO_COMPARISON
  OPTIMIZATION
  VALIDATIONS
  RENDERS
  THREE_D_VIEWS
  CONCLUSIONS
  NOTES
  DISCLAIMER
}

model ProjectDocument {
  id            String              @id @default(uuid())
  projectId     String
  project       Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenarioId    String?
  alternativeId String?
  templateId    String?
  name          String
  description   String?
  type          DocumentType        @default(PROJECT_DOSSIER)
  status        DocumentStatus      @default(DRAFT)
  language      String              @default("es")
  version       String              @default("1.0")
  orientation   DocumentOrientation @default(PORTRAIT)
  pageSize      DocumentPageSize    @default(A4)
  metadata      Json                @default("{}")
  sections      DocumentSection[]
  history       DocumentHistory[]
  createdById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@map("project_documents")
}

model DocumentSection {
  id          String              @id @default(uuid())
  documentId  String
  document    ProjectDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  type        DocumentSectionType
  title       String
